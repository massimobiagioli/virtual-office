# Virtual Office environment variables (Constitution §15.11, DOCKER.md §2).
#
# Copy this file to `.env` (git-ignored) and adjust the values: `cp .env.example .env`.
# Never commit `.env` and never put a real secret in this file.
#
# How the values reach the services: `docker compose` reads `.env` from the repository root
# only to fill the `${VO_*}` placeholders of `docker-compose.yml`; the services themselves
# never read a `.env` file, they get exactly the variables listed under `environment:`.
# `python -I scripts/check_env_example.py` fails when a variable is missing from this file.

# --- Read by docker compose from .env -------------------------------------------------------

# Tag of the images compose builds and runs (`virtual-office/<service>:<tag>`). CI will set it
# to the current commit (WP03); locally any fixed name works. Optional for now, defaults to `dev`.
VO_IMAGE_TAG=dev

# Log level of core and catalog: DEBUG, INFO, WARNING or ERROR. Optional, defaults to INFO.
VO_LOG_LEVEL=INFO

# Base URL of the Ollama HTTP API used by core for every model call (OLLAMA.md). Optional,
# defaults to the `ollama` service on the compose network.
VO_OLLAMA_BASE_URL=http://ollama:11434/

# --- Set by docker-compose.yml for each service (reference only) ----------------------------
# Compose fixes these addresses on its internal network, so a value in .env has no effect.

# Database DSN of each service, without a password until postgres arrives (WP02, POSTGRES.md):
# core uses `postgresql+asyncpg://core_app@postgres:5432/core`, catalog the one below.
# VO_DATABASE_URL=postgresql+asyncpg://catalog_app@postgres:5432/catalog

# Base URL of the catalog HTTP API, read by core.
# VO_CATALOG_URL=http://catalog:8001/
