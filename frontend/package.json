{
  "name": "virtual-office-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "My Workbench: the Virtual Office single-page application.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "24.22.0",
    "pnpm": "12.14.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint --flag unstable_native_nodejs_ts_config --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "vue-tsc --build",
    "test": "vitest run",
    "test:watch": "vitest --coverage.enabled=false",
    "coverage": "vitest run --coverage.reporter=text --coverage.reporter=json-summary --coverage.reporter=html",
    "check:tooling": "node tooling-fixtures/check-tooling.ts"
  },
  "dependencies": {
    "pinia": "4.1.0",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "5.0.5",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-vue": "10.11.1",
    "fast-check": "4.10.2",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}
